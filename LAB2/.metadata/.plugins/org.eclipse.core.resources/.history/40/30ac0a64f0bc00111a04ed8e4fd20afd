/**
 * @brief  Trình phục vụ ngắt của Timer 2, được g�?i mỗi 10ms.
 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
#if (EXERCISE == 1)
  /* ------------------------------- Bài 1 ------------------------------- */
  scan_counter--;
  if (scan_counter <= 0) {
    scan_counter = MS_TO_TICK(SCAN_PERIOD_500MS);   /* 500ms */

    enable7SEG(-1);                                 /* tắt cả 2 LED        */
    if (index_led == 0) {
      display7SEG(1);                               /* LED 1 hiển thị số 1 */
      enable7SEG(0);
    } else {
      display7SEG(2);                               /* LED 2 hiển thị số 2 */
      enable7SEG(1);
    }
    index_led = 1 - index_led;                      /* luân phiên 2 LED    */
  }

#elif (EXERCISE == 2)
  /* ------------------------------- Bài 2 ------------------------------- */
  scan_counter--;
  if (scan_counter <= 0) {
    scan_counter = MS_TO_TICK(SCAN_PERIOD_500MS);   /* 500ms */

    enable7SEG(-1);
    display7SEG(display_value[index_led]);
    enable7SEG(index_led);

    index_led++;
    if (index_led >= MAX_LED) {
      index_led = 0;
    }
  }

  dot_counter--;
  if (dot_counter <= 0) {
    dot_counter = MS_TO_TICK(DOT_PERIOD);           /* 1000ms */
    toggleDot();
  }

#elif (EXERCISE == 3)
  /* ------------------------------- Bài 3 ------------------------------- */
  scan_counter--;
  if (scan_counter <= 0) {
    scan_counter = MS_TO_TICK(SCAN_PERIOD_500MS);   /* 500ms */

    update7SEG(index_led++);
    if (index_led >= MAX_LED) {
      index_led = 0;
    }
  }

#elif (EXERCISE == 4) || (EXERCISE == 5)
  /* ---------------------------- Bài 4 và 5 ----------------------------- */
  scan_counter--;
  if (scan_counter <= 0) {
    scan_counter = MS_TO_TICK(SCAN_PERIOD_1HZ);     /* 250ms -> 4 LED = 1Hz */

    update7SEG(index_led++);
    if (index_led >= MAX_LED) {
      index_led = 0;
    }
  }

  dot_counter--;
  if (dot_counter <= 0) {
    dot_counter = MS_TO_TICK(DOT_PERIOD);           /* 1000ms */
    toggleDot();
  }

#elif (EXERCISE == 6)
  /* ------------------------------- Bài 6 ------------------------------- */
  timer_run();                                      /* đếm software timer */

  scan_counter--;
  if (scan_counter <= 0) {
    scan_counter = MS_TO_TICK(SCAN_PERIOD_1HZ);
    update7SEG(index_led++);
    if (index_led >= MAX_LED) {
      index_led = 0;
    }
  }

  dot_counter--;
  if (dot_counter <= 0) {
    dot_counter = MS_TO_TICK(DOT_PERIOD);
    toggleDot();
  }

#elif (EXERCISE == 7)
  /* ------------------------------- Bài 7 ------------------------------- */
  timer_run();

  /* DOT đã chuyển ra main, trong ngắt chỉ còn việc quét LED 7 đoạn */
  scan_counter--;
  if (scan_counter <= 0) {
    scan_counter = MS_TO_TICK(SCAN_PERIOD_1HZ);
    update7SEG(index_led++);
    if (index_led >= MAX_LED) {
      index_led = 0;
    }
  }

#else
  /* --------------------------- Bài 8, 9, 10 ---------------------------- */
  /* M�?i xử lý đã chuyển ra main, ngắt chỉ còn đếm các software timer
   * -> th�?i gian nằm trong ngắt là ngắn nhất, tránh lồng ngắt (nested
   *    interrupt) và bảo đảm tính th�?i gian thực của hệ thống.          */
  timer_run();
#endif
}
