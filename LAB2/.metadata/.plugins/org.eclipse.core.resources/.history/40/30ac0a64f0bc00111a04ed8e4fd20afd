/* ==========================================================================
 *  LAB 2 - TIMER INTERRUPT AND LED SCANNING
 *
 *  Ch�?n bài tập muốn build bằng macro EXERCISE trong Core/Inc/lab_config.h
 *  Ngắt Timer 2 có chu kỳ 10ms: 8MHz / (7999+1) / (9+1) = 100Hz
 * ========================================================================== */

#if (EXERCISE == 1)
/* --------------------------------------------------------------------------
 * Bài 1: 2 LED 7 đoạn, LED thứ nhất hiển thị "1", LED thứ hai hiển thị "2",
 *        th�?i gian chuyển giữa 2 LED là nửa giây.
 *
 * Short question: tần số của quá trình quét
 *        f = 1 / (2 x 0.5s) = 1Hz
 * -------------------------------------------------------------------------- */
int scan_counter = MS_TO_TICK(SCAN_PERIOD_500MS);   /* 50 lần ngắt = 500ms */

#elif (EXERCISE == 2)
/* --------------------------------------------------------------------------
 * Bài 2: 4 LED 7 đoạn hiển thị 1 - 2 - 3 - 0 (12 gi�? 30), mỗi LED sáng 500ms.
 *        2 LED DOT ở giữa nhấp nháy mỗi 1 giây.
 *
 * Short question: tần số của quá trình quét
 *        f = 1 / (4 x 0.5s) = 0.5Hz
 * -------------------------------------------------------------------------- */
int display_value[MAX_LED] = { 1, 2, 3, 0 };
int scan_counter = MS_TO_TICK(SCAN_PERIOD_500MS);   /* 500ms  */
int dot_counter  = MS_TO_TICK(DOT_PERIOD);          /* 1000ms */

#elif (EXERCISE == 3)
/* --------------------------------------------------------------------------
 * Bài 3: dùng hàm update7SEG(int index) với mảng led_buffer[4] = {1,2,3,4}.
 *        Hàm được cài đặt trong Core/Src/led7seg.c
 *        �?ổi giá trị của led_buffer trong led7seg.c để kiểm tra hàm này.
 * -------------------------------------------------------------------------- */
int scan_counter = MS_TO_TICK(SCAN_PERIOD_500MS);   /* 500ms */

#elif (EXERCISE == 4)
/* --------------------------------------------------------------------------
 * Bài 4: đổi chu kỳ g�?i update7SEG để tần số quét 4 LED 7 đoạn bằng 1Hz
 *        -> mỗi LED sáng 1s / 4 = 250ms. 2 LED DOT vẫn nháy mỗi 1 giây.
 * -------------------------------------------------------------------------- */
int scan_counter = MS_TO_TICK(SCAN_PERIOD_1HZ);     /* 250ms  */
int dot_counter  = MS_TO_TICK(DOT_PERIOD);          /* 1000ms */

#elif (EXERCISE == 5) || (EXERCISE == 6)
/* --------------------------------------------------------------------------
 * Bài 5: đồng hồ số hiển thị gi�? - phút trên 4 LED 7 đoạn, gi�? phút giây
 *        được cập nhật trong main bằng HAL_Delay(1000).
 * Bài 6: giữ nguyên phần cứng/ngắt của bài 5, thêm software timer và dùng nó
 *        để nháy LED đ�? PA5 trong main (Program 1.8) thay cho HAL_Delay.
 * -------------------------------------------------------------------------- */
int hour   = CLOCK_INIT_HOUR;
int minute = CLOCK_INIT_MINUTE;
int second = CLOCK_INIT_SECOND;
int scan_counter = MS_TO_TICK(SCAN_PERIOD_1HZ);     /* 250ms  */
int dot_counter  = MS_TO_TICK(DOT_PERIOD);          /* 1000ms */

#elif (EXERCISE == 7)
/* --------------------------------------------------------------------------
 * Bài 7: đồng hồ số của bài 5 được cập nhật bằng software timer,
 *        HAL_Delay(1000) bị loại b�? và 2 LED DOT chuyển ra hàm main.
 *        Việc quét LED 7 đoạn vẫn còn nằm trong ngắt (sẽ chuyển ở bài 8).
 * -------------------------------------------------------------------------- */
int hour   = CLOCK_INIT_HOUR;
int minute = CLOCK_INIT_MINUTE;
int second = CLOCK_INIT_SECOND;
int scan_counter = MS_TO_TICK(SCAN_PERIOD_1HZ);     /* 250ms */

#else   /* EXERCISE 8, 9, 10 */
/* --------------------------------------------------------------------------
 * Bài 8 : chuyển luôn update7SEG ra main. Ngắt timer chỉ còn timer_run(),
 *         toàn bộ xử lý nằm trong vòng lặp vô tận của main.
 * Bài 9 : thêm LED matrix 8x8 hiển thị ký tự 'A' (quét bằng timer3).
 * Bài 10: animation - chuỗi ký tự dịch dần sang trái trên LED matrix.
 * -------------------------------------------------------------------------- */
int hour   = CLOCK_INIT_HOUR;
int minute = CLOCK_INIT_MINUTE;
int second = CLOCK_INIT_SECOND;
#endif
