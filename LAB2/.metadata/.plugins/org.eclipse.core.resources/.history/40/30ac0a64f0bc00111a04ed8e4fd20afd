/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */
  /* Tắt toàn bộ LED trước khi bắt đầu quét */
  enable7SEG(-1);
  display7SEG(LED_BLANK);
  setDot(0);
  clearLEDMatrix();

#if (EXERCISE >= 5)
  /* Nạp gi�? khởi tạo lên 4 LED 7 đoạn */
  updateClockBuffer(hour, minute);
#endif

#if (EXERCISE == 9)
  /* Bài 9: hiển thị ký tự 'A' trên LED matrix */
  loadCharToMatrix('A');
#elif (EXERCISE == 10)
  /* Bài 10: dựng chuỗi ký tự sẽ chạy trên LED matrix */
  initScrollText(MATRIX_SCROLL_TEXT);
  shiftLEDMatrixLeft();
#endif

  /* Bật ngắt của Timer 2 - chu kỳ 10ms */
  HAL_TIM_Base_Start_IT(&htim2);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
#if (EXERCISE == 6)
  /* Bài 6 - Program 1.8: khởi động software timer trước vòng lặp */
  setTimer0(BLINK_PERIOD);              /* setTimer0(1000)       */
#elif (EXERCISE == 7)
  setTimer0(CLOCK_PERIOD);              /* 1 giây của đồng hồ    */
  setTimer2(DOT_PERIOD);                /* nhấp nháy 2 LED DOT   */
#elif (EXERCISE >= 8)
  setTimer0(CLOCK_PERIOD);              /* 1 giây của đồng hồ    */
  setTimer1(SCAN_PERIOD_1HZ);           /* quét 4 LED 7 đoạn     */
  setTimer2(DOT_PERIOD);                /* nhấp nháy 2 LED DOT   */
#if (EXERCISE >= 9)
  setTimer3(MATRIX_SCAN_PERIOD);        /* quét LED matrix 8x8   */
#endif
#if (EXERCISE == 10)
  setTimer4(MATRIX_SHIFT_PERIOD);       /* tốc độ chạy chữ       */
#endif
#endif

  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
#if (EXERCISE == 5)
    /* ---------------------------------------------------------------------
     * Bài 5: đồng hồ số dùng HAL_Delay - đây là delay chặn (blocking delay),
     *        cả vòng lặp main bị treo 1 giây. Việc quét LED 7 đoạn vẫn chạy
     *        được vì nó nằm trong ngắt của Timer 2.
     * --------------------------------------------------------------------- */
    second++;
    if (second >= 60) {
      second = 0;
      minute++;
    }
    if (minute >= 60) {
      minute = 0;
      hour++;
    }
    if (hour >= 24) {
      hour = 0;
    }
    updateClockBuffer(hour, minute);
    HAL_Delay(1000);

#elif (EXERCISE == 6)
    /* ---------------------------------------------------------------------
     * Bài 6 - Program 1.8: nháy LED đ�? PA5 bằng software timer.
     *
     * Report 1: nếu thiếu setTimer0(1000) trước vòng lặp thì timer0_counter
     *           vẫn bằng 0. Hàm timer_run() chỉ đếm khi counter > 0 nên
     *           timer0_flag không bao gi�? được bật -> LED không bao gi�? nháy.
     * Report 2: setTimer0(1) -> counter = 1 / TIMER_CYCLE = 1/10 = 0 (phép
     *           chia nguyên) -> giống hệt trư�?ng hợp trên, LED cũng không nháy.
     * Report 3: setTimer0(10) -> counter = 1, chỉ sau 1 lần ngắt (10ms) c�? đã
     *           lên 1 nên LED CÓ nháy (khác hai câu trên). Lần đảo trạng thái
     *           đầu tiên xảy ra sau 10ms thay vì sau 1s, các lần sau vẫn theo
     *           setTimer0(2000) nên chu kỳ nháy trở lại 2 giây.
     * --------------------------------------------------------------------- */
    if (timer0_flag == 1) {
      HAL_GPIO_TogglePin(LED_RED_GPIO_Port, LED_RED_Pin);
      setTimer0(2 * BLINK_PERIOD);      /* setTimer0(2000) */
    }

#elif (EXERCISE >= 7)
    /* ---------------------------------------------------------------------
     * Bài 7 trở đi: đồng hồ số được cập nhật bằng software timer,
     *               không còn HAL_Delay (non-blocking).
     * --------------------------------------------------------------------- */
    if (timer0_flag == 1) {
      setTimer0(CLOCK_PERIOD);

      second++;
      if (second >= 60) {
        second = 0;
        minute++;
      }
      if (minute >= 60) {
        minute = 0;
        hour++;
      }
      if (hour >= 24) {
        hour = 0;
      }
      updateClockBuffer(hour, minute);
    }

    /* 2 LED DOT được chuyển từ ngắt ra hàm main */
    if (timer2_flag == 1) {
      setTimer2(DOT_PERIOD);
      toggleDot();
    }

#if (EXERCISE >= 8)
    /* Bài 8: việc quét 4 LED 7 đoạn cũng được chuyển ra kh�?i ngắt */
    if (timer1_flag == 1) {
      setTimer1(SCAN_PERIOD_1HZ);
      update7SEG(index_led++);
      if (index_led >= MAX_LED) {
        index_led = 0;
      }
    }
#endif

#if (EXERCISE >= 9)
    /* Bài 9: quét LED matrix 8x8, mỗi cột sáng MATRIX_SCAN_PERIOD ms */
    if (timer3_flag == 1) {
      setTimer3(MATRIX_SCAN_PERIOD);
      updateLEDMatrix(index_led_matrix++);
      if (index_led_matrix >= MAX_LED_MATRIX) {
        index_led_matrix = 0;
      }
    }
#endif

#if (EXERCISE == 10)
    /* Bài 10: cứ MATRIX_SHIFT_PERIOD ms lại dịch nội dung sang trái 1 cột */
    if (timer4_flag == 1) {
      setTimer4(MATRIX_SHIFT_PERIOD);
      shiftLEDMatrixLeft();
    }
#endif
#endif
  }
  /* USER CODE END 3 */
}

